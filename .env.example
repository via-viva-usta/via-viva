# Copia este archivo como .env y llena los valores. .env NUNCA se sube al repositorio.

# --- Base de datos (db/acceso.py) ---
# SQLite por defecto; ruta relativa a la carpeta via-viva/. Futuro: postgresql://usuario:clave@servidor:5432/via_viva
VIA_VIVA_DB_URL=sqlite:///data/via_viva.db

# --- Bot ciudadano (Telegram) ---
# Token que da @BotFather. NUNCA se sube al repositorio ni se comparte por chat.
TELEGRAM_BOT_TOKEN=
# Sal para el hash del id de usuario: una frase larga al azar (no cambiarla después: los hashes dejarían de coincidir)
BOT_SAL_HASH=

# --- Scraping ---
# Identificación del bot ante los sitios (buena práctica). Pon un correo de contacto del equipo.
SCRAPER_USER_AGENT=ViaVivaBot/0.1 (proyecto academico USTA Tunja; contacto: CORREO_DEL_EQUIPO)
# Token de aplicación de datos.gov.co (Socrata). Opcional: sin token funciona con límites más bajos.
SOCRATA_APP_TOKEN=

# --- Wi-Fi del nodo (solo para pruebas locales; el firmware real no lee este archivo) ---
NODE_WIFI_SSID=
NODE_WIFI_PASSWORD=

# --- Raspberry Pi 4: nodo central (7-nov) ---
PI_ID_NODO=pi-01
# Clave del WiFi VIA-VIVA que crea la Pi (mín. 8 caracteres). Si queda vacía, pi/instalar.sh la pide en la consola.
PI_AP_CLAVE=
# Pines BCM (opcional; por defecto los de pi/config.py, pendientes de confirmar con el hardware)
# PI_PIN_INT1=17
# PI_PIN_DHT22=4
# PI_PIN_PULSADOR=27
# PI_PIN_LED=22

# --- Sincronización opcional con Supabase (pi/sincronizacion.py) ---
# Vacías = nada sale de la Pi. URL del proyecto (https://xxxx.supabase.co) y clave SECRETA del proyecto
# (solo en el .env de la Pi; las tablas tienen RLS de solo lectura pública: pi/supabase_esquema.sql).
SUPABASE_URL=
SUPABASE_CLAVE=
