[Unit]
Description=VÍA VIVA - nodo central (sensores, captura, tablero, sincronización)
After=network.target
# Arranca aunque no haya internet: todo es local primero.

[Service]
Type=simple
User=__USUARIO__
WorkingDirectory=__RAIZ__
Environment=PYTHONIOENCODING=utf-8 PYTHONUNBUFFERED=1
ExecStart=__RAIZ__/pi/.venv/bin/python -m pi.servidor --fuente sensores --puerto 80 --permitir-apagado
# Puerto 80 sin ser root, y prioridad de tiempo real para el hilo que vacía la FIFO del ADXL345
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SYS_NICE
SupplementaryGroups=gpio i2c spi dialout
Restart=always
RestartSec=3
# Al detener: SIGTERM → el servidor cierra la grabación con fsync antes de salir
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
